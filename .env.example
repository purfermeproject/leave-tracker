# ── Google Sheets (required for both local dev and production) ─────────────────
# 1. Create a Google Cloud project, enable Sheets API, create a Service Account
# 2. Share your spreadsheet with the service account email (Editor access)
# 3. Copy the spreadsheet ID from the URL: .../spreadsheets/d/<ID>/edit

GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Local dev only ─────────────────────────────────────────────────────────────
PORT=3001
