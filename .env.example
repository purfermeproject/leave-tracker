# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── Database (choose one) ─────────────────────────────────────────────────────
# Option A: connection string (Supabase / Railway / Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: individual fields (local development)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=leave_tracker
PG_USER=postgres
PG_PASSWORD=your_password_here

# ── Optional ──────────────────────────────────────────────────────────────────
# API server port (defaults to 3001)
PORT=3001
# Allowed CORS origin (defaults to http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173
# Set to 'production' to enforce SSL on DB connections
NODE_ENV=development
